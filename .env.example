# shared
APP_ENV=development                 # development | production
PUBLIC_BASE_URL=https://localhost:5173
DEMO_MODE=true                      # enables /simulator and /demo endpoints
DEMO_CLOCK_START=                   # e.g. 2026-10-12T11:00:00+05:30 ; empty = real clock
MILL_TIMEZONE=Asia/Kolkata

# backend
DATABASE_URL=postgresql+psycopg://loomlink:loomlink@db:5432/loomlink
JWT_SECRET=change-me-32-chars-min
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=https://localhost:5173
LOG_LEVEL=INFO

# Ripple / Bol / Buyer Line (Lane B)
RIPPLE_DEBOUNCE_MS=500
LLM_PROVIDER=none                   # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=                          # set when LLM_PROVIDER=anthropic
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=               # whatsapp:+14155238886 (sandbox)

# frontend (Vite)
VITE_API_BASE=/api/v1
VITE_USE_MOCKS=false
VITE_MOCK_MODULES=                   # comma list of modules still mocked when VITE_USE_MOCKS=true
VITE_PUBLIC_BASE_URL=https://localhost:5173
