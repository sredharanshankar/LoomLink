# API base URL (leave empty to use MSW mocks)
VITE_API_BASE_URL=

# Comma-separated list of modules still backed by MSW mocks.
# Empty = all requests go to the real API.
# Unset (variable not present) = all modules are mocked (default dev mode).
VITE_MOCK_MODULES=inventory,orders,production,quality,dispatch,workers,finance
